meta {
  name: Missing Latitude
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/locations?longitude=142.375917
  body: none
  auth: none
}

params:query {
  longitude: 142.375917
}

tests {
  test("Status is 400", function() {
    expect(res.status).to.equal(400);
  });

  test("Error message is correct", function() {
    expect(res.body.error).to.equal("latitude is required");
  });
}
