meta {
  name: Empty Result (Remote Area)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/locations?latitude=0.000000&longitude=0.000000&radius=1
  body: none
  auth: none
}

params:query {
  latitude: 0.000000
  longitude: 0.000000
  radius: 1
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Response is empty array", function() {
    expect(res.body).to.be.an('array');
    expect(res.body.length).to.equal(0);
  });
}
